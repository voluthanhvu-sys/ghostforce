+const diagnosticTrackPointForWho = (who, t, track) => {
+    const name = String(who || '').toLowerCase().trim();
+    if (!name || !Array.isArray(track) || !track.length) return null;
+    const matching = track.filter((p) => {
+        if (!isSpeakerIdentity(p.who)) return false;
+        const candidate = String(p.who || '').toLowerCase();
+        return candidate && (candidate === name || candidate.includes(name) || name.includes(candidate));
+    });
+    if (!matching.length) return null;
+    return matching.reduce((best, point) => (
+        Math.abs((Number(point.t) || 0) - t) < Math.abs((Number(best.t) || 0) - t) ? point : best
+    ));
+};
+
+const diagnosticNearestTrackHint = (t, w, track) => {
+    if (!Array.isArray(track) || !track.length) return null;
+    const nearTime = track
+        .filter((p) => p.t >= w.a - 0.25 && p.t <= w.b + 0.25)
+        .sort((a, b) => Math.abs(a.t - t) - Math.abs(b.t - t));
+    if (nearTime.length) return nearTime[0];
+    const mid = (w.a + w.b) / 2;
+    const nearWindow = track
+        .filter((p) => p.t >= w.a - 0.4 && p.t <= w.b + 0.4)
+        .sort((a, b) => Math.abs(a.t - mid) - Math.abs(b.t - mid));
+    return nearWindow[0] || track[0] || null;
+};
