+const detailRawFillMismatchLines = (rawFrames, rawCounts, parsedCounts, prefix) => {
+    if (Number(rawCounts?.contain) === Number(parsedCounts?.contain)
+        && Number(rawCounts?.fill) === Number(parsedCounts?.fill)) return [];
+    const clean = (value, max = 160) => String(value || '')
+        .replace(/[\r\n\t]+/g, ' ')
+        .replace(/\s+/g, ' ')
+        .trim()
+        .slice(0, max);
+    const rawValue = (value) => value === undefined ? 'missing' : JSON.stringify(value);
+    const lines = [];
+    (Array.isArray(rawFrames) ? rawFrames : []).forEach((frame, index) => {
+        const rawMode = Array.isArray(frame)
+            ? frame[2]
+            : frame?.mode || frame?.kind || frame?.framing || frame?.type;
+        if (normalizeFrameMode(rawMode) !== 'fill') return;
+        const start = Array.isArray(frame) ? frame[0] : frame?.start ?? frame?.from ?? frame?.t0;
+        const end = Array.isArray(frame) ? frame[1] : frame?.end ?? frame?.to ?? frame?.t1;
+        const why = clean(Array.isArray(frame) ? frame[3] : frame?.why || frame?.reason);
+        const focusLock = !Array.isArray(frame) && frame?.focusLock === true;
+        const focalWho = !Array.isArray(frame) ? clean(frame?.focalWho, 80) : '';
+        const hasFocalCx = !Array.isArray(frame) && frame?.focalCx !== undefined;
+        const focalCx = focusLock && !hasFiniteFocusCx(frame)
+            ? ' focalCx=invalid'
+            : (hasFocalCx ? ` focalCx=${rawValue(frame.focalCx)}` : '');
+        lines.push(`[EDIT] ${prefix} frame ${index + 1}: ${rawValue(start)}-${rawValue(end)} · why=${JSON.stringify(why)} · focusLock=${focusLock}${focalWho ? ` focalWho=${JSON.stringify(focalWho)}` : ''}${focalCx}`);
+    });
+    return lines;
+};
