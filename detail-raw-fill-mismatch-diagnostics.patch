+test('raw FILL mismatch diagnostics emit only on count mismatch without mutation', () => {
+  const raw = [
+    { start: '45.0', end: '45.5', mode: 'fill', why: 'short reaction', focusLock: true, focalWho: 'Jeffy' },
+    { start: 45.5, end: 52, mode: 'contain', why: 'wide context' },
+  ];
+  const before = structuredClone(raw);
+  assert.deepEqual(detailRawFillMismatchLines(raw, { contain: 1, fill: 1 }, { contain: 1, fill: 1 }, 'TARGETED Detail raw FILL Part 3'), []);
+  const lines = detailRawFillMismatchLines(raw, { contain: 1, fill: 1 }, { contain: 1, fill: 0 }, 'TARGETED Detail raw FILL Part 3');
+  assert.equal(lines.length, 1);
+  assert.match(lines[0], /frame 1: "45\.0"-"45\.5"/);
+  assert.match(lines[0], /why="short reaction"/);
+  assert.match(lines[0], /focusLock=true focalWho="Jeffy" focalCx=invalid/);
+  assert.deepEqual(raw, before);
+});
