--- /dev/null
+++ b/tests/edit-track-hint.test.js
@@ -0,0 +1,24 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { hintCxForWindow } from '../ghostforge-server.js';
+
+test('hintCxForWindow uses a track point inside the existing local time range', () => {
+  const window = { a: 72.1, b: 72.6 };
+  const track = [
+    { t: 0, cx: 0.58 },
+    { t: 72.3, cx: 0.27 },
+  ];
+
+  assert.equal(hintCxForWindow(window, track), 0.27);
+});
+
+test('hintCxForWindow returns neutral fallback when no track point is local', () => {
+  const window = { a: 72.1, b: 72.6 };
+  const track = [
+    { t: 0, cx: 0.58 },
+    { t: 20, cx: 0.31 },
+  ];
+
+  assert.equal(hintCxForWindow(window, track), 0.5);
+  assert.notEqual(hintCxForWindow(window, track), track[0].cx);
+});
