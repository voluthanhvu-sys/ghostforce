diff --git a/tests/detail-focus-lock.test.js b/tests/detail-focus-lock.test.js
new file mode 100644
--- /dev/null
+++ b/tests/detail-focus-lock.test.js
@@ -0,0 +1,37 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { applySpeechToWindows, splitFillOnSpeaker } from '../ghostforge-server.js';
+
+const speech = [{ t: 1, end: 3, who: 'Marvin', cx: 0.2, cy: 0.4 }];
+
+test('valid focus lock prevents overlapping STT from replacing Detail FILL', () => {
+  const locked = [{ a: 0, b: 4, mode: 'fill', planMode: 'fill', focusLock: true, focalWho: 'Jeffy', focalCx: 0.72 }];
+  assert.deepEqual(applySpeechToWindows(locked, speech), locked);
+});
+
+test('unlocked Detail FILL keeps existing active-speaker STT behavior', () => {
+  const windows = [{ a: 0, b: 4, mode: 'fill', planMode: 'fill', cx: 0.72 }];
+  const result = applySpeechToWindows(windows, speech);
+  assert.equal(result.some((w) => w.who === 'Marvin' && w.cx === 0.2), true);
+});
+
+test('focus lock without valid focalCx keeps existing STT behavior', () => {
+  const windows = [{ a: 0, b: 4, mode: 'fill', planMode: 'fill', focusLock: true, focalWho: 'Jeffy' }];
+  const result = applySpeechToWindows(windows, speech);
+  assert.equal(result.some((w) => w.who === 'Marvin' && w.cx === 0.2), true);
+});
+
+test('speaker track does not split or retarget a valid focus-locked FILL', () => {
+  const locked = [{ a: 0, b: 4, mode: 'fill', planMode: 'fill', focusLock: true, focalWho: 'Jeffy', focalCx: 0.72 }];
+  const track = [
+    { t: 0.5, who: 'Marvin', cx: 0.2 },
+    { t: 2.5, who: 'Junior', cx: 0.8 },
+  ];
+  assert.deepEqual(splitFillOnSpeaker(locked, track), locked);
+});
