diff --git a/server/ffmpeg-diagnostics.js b/server/ffmpeg-diagnostics.js
new file mode 100644
--- /dev/null
+++ b/server/ffmpeg-diagnostics.js
@@ -0,0 +1,11 @@
+const FFMPEG_ERROR_PATTERN = /error|invalid|unable|failed|undefined|no such|option|expression|parse|filter|crop/i;
+
+export const firstMeaningfulFfmpegError = (stderr) => {
+    const lines = String(stderr || '')
+        .split(/\r?\n/)
+        .map((line) => line.trim())
+        .filter(Boolean);
+    return lines.find((line) => FFMPEG_ERROR_PATTERN.test(line))
+        || lines.at(-1)
+        || 'ffmpeg failed without stderr output';
+};
diff --git a/tests/ffmpeg-diagnostics.test.js b/tests/ffmpeg-diagnostics.test.js
new file mode 100644
--- /dev/null
+++ b/tests/ffmpeg-diagnostics.test.js
@@ -0,0 +1,27 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { firstMeaningfulFfmpegError } from '../server/ffmpeg-diagnostics.js';
+
+test('firstMeaningfulFfmpegError returns the earliest useful error line', () => {
+    const stderr = [
+        'ffmpeg version 7.1',
+        'frame=  42 fps=30 time=00:00:01.40 speed=1x',
+        'Error when evaluating the expression x',
+        'Failed to configure input pad',
+    ].join('\n');
+    assert.equal(firstMeaningfulFfmpegError(stderr), 'Error when evaluating the expression x');
+});
+
+test('firstMeaningfulFfmpegError ignores irrelevant progress lines', () => {
+    const stderr = [
+        'frame=  42 fps=30 time=00:00:01.40 speed=1x',
+        'bitrate=1200.0kbits/s',
+        'Invalid argument',
+    ].join('\n');
+    assert.equal(firstMeaningfulFfmpegError(stderr), 'Invalid argument');
+});
+
+test('firstMeaningfulFfmpegError falls back safely without a keyword', () => {
+    assert.equal(firstMeaningfulFfmpegError('ffmpeg version 7.1\nconversion stopped'), 'conversion stopped');
+    assert.equal(firstMeaningfulFfmpegError(''), 'ffmpeg failed without stderr output');
+});
