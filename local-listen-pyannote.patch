+const planSpeakerIntervals = (plan) => {
+    const intervals = [];
+    for (const seg of plan?.segments || []) {
+        const base = Number(seg.start) || 0;
+        const end = Number(seg.end) || base;
+        const pts = (Array.isArray(seg.track) ? seg.track : [])
+            .filter((p) => p && Number.isFinite(p.t) && String(p.who || '').trim())
+            .map((p) => ({ ...p, sourceT: base + p.t }))
