+  assert.match(guidance, /keep it FILL even when no focusLock metadata is emitted/i);
+  assert.ok(guidance.indexOf('DIALOGUE GUARD:') < guidance.indexOf('MODE SELECTION FIRST:'));
+  assert.ok(guidance.indexOf('MODE SELECTION FIRST:') < guidance.indexOf('OPTIONAL REACTION FOCUS LOCK'));
 });
