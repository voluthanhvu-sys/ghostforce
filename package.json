{
  "name": "ghostforge-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8080",
    "build": "vite build --configLoader native",
    "start": "node launch.mjs",
    "test": "node --test tests/*.test.js",
    "check:server": "node scripts/check-server.mjs",
    "validate:handoff": "node scripts/validate-handoff.mjs",
    "validate": "npm run validate:handoff && npm test && npm run check:server"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.510.0",
    "multer": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.4",
    "vite": "^6.3.4"
  }
}
